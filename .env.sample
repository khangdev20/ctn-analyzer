# Sample .env file for S3 Integration Testing
# Copy this to .env and update with your actual values

# Redis Configuration (Hot Path - unchanged)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Discord Webhook (Notifications)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your-webhook-url

# LLM API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# AWS S3 Configuration (Cold Storage)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_PREFIX=trending-intelligence

# S3 Security & Encryption
AWS_S3_KMS_KEY_ID=                    # Optional: KMS key ID for encryption
AWS_S3_SSE=AES256                     # Or "aws:kms" if using KMS

# S3 Connection & Retry Settings
AWS_MAX_RETRIES=3
AWS_TIMEOUT_SECONDS=20

# AWS Credentials (use IAM role in production)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log