# Trending Intelligence Analyzer - Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED API KEYS =====
# OpenAI API key for strategic analysis (required)
OPENAI_API_KEY=your_openai_api_key_here

# Discord webhook URL for notifications (required)
DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/your_webhook_url_here

# ===== OPTIONAL PIPELINE CONFIGURATION =====
# How often to run the pipeline (minutes)
TRENDING_COLLECTION_INTERVAL=15

# How many pages to collect per run
TRENDING_BATCH_SIZE=3

# Which LLM model to use for analysis
TRENDING_LLM_MODEL=gpt-4o-mini

# Enable/disable Discord notifications
TRENDING_DISCORD_ENABLED=true

# Threshold for viral content detection (0-100)
TRENDING_VIRAL_THRESHOLD=80.0

# Maximum processing time per pipeline run (minutes)
TRENDING_MAX_PROCESSING_TIME=10

# ===== FLASK CONFIGURATION =====
# Flask secret key (change this for production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Flask debug mode (true for development)
FLASK_DEBUG=false

# Port to run the Flask server on
PORT=5000

# ===== LOGGING CONFIGURATION =====
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=bot.log

# ===== OPTIONAL: OTHER LLM PROVIDERS =====
# Anthropic API key (for Claude models)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Google AI API key (for Gemini models)
# GOOGLE_AI_API_KEY=your_google_ai_key_here

# ===== OPTIONAL: DATABASE CONFIGURATION =====
# Database URL (default: SQLite)
# DATABASE_URL=sqlite:///trending_intelligence.db

# Redis URL (for advanced features)
# REDIS_URL=redis://localhost:6379/0

# ===== PERFORMANCE TUNING =====
# Maximum number of worker threads
MAX_WORKERS=4

# API timeout in seconds
API_TIMEOUT=30

# Rate limit (requests per minute)
RATE_LIMIT=100